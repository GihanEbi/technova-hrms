{
  "name": "technova-hrms",
  "version": "1.0.0",
  "private": true,
  "description": "TechNova HR & Payroll \u2014 frontend prototype with mock data",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-demo-data.ts --date 2026-10-30T10:30:00",
    "test:e2e": "playwright test --project=e2e --project=mobile",
    "test:e2e:ui": "playwright test --ui --project=e2e --project=mobile",
    "test:e2e:report": "playwright show-report",
    "docs:screenshots": "cross-env DOCS=1 playwright test --project=docs screenshots.spec.ts",
    "docs:videos": "cross-env DOCS=1 playwright test --project=docs walkthroughs.spec.ts",
    "docs:generate": "npm run docs:screenshots && npm run docs:videos && tsx scripts/generate-documentation.ts",
    "docs:verify": "tsx scripts/verify-documentation.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.8.2",
    "immer": "^10.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.65.0",
    "motion": "^12.43.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "marked": "^18.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}